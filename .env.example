# Copy to .env (gitignored) and fill in. The justfile loads it (set dotenv-load).
# Everything boots with zero keys: LLM_MODE=mock runs the scripted engine.

# Anthropic key: only needed for the live engine. Prod reads it from Secret Manager.
ANTHROPIC_API_KEY=

# mock (scripted engine, default everywhere except prod) | live
LLM_MODE=mock
# genkit (default) | anthropic (fallback engine, plan §4.7)
LLM_ENGINE=genkit
# memory (default) | firestore (stretch)
STORE=memory
# Space-separated CSP frame-ancestors (plan §6.5); keep the inner single quotes on 'self'.
ALLOWED_FRAME_ANCESTORS="'self'"

# Agent lane settings (AGENT_ prefix, backend/app/agent/settings.py)
# anthropic (default) | google
AGENT_LLM_PROVIDER=anthropic
# Only for AGENT_LLM_PROVIDER=google
GEMINI_API_KEY=
# Model ids default per provider (anthropic: claude-sonnet-5-5 / claude-haiku-5-5,
# google: gemini-3.1-pro-preview / gemini-3.8-flash). Set both to override.
# AGENT_MODEL_CHAT=
# AGENT_MODEL_FAST=

# X-Demo-Key header value that skips rate limits on demo devices (empty = no bypass)
DEMO_KEY=

# Only if voice ships (L11). The Web Speech fallback needs no key.
# ELEVENLABS_API_KEY=

# Optional: pin this worktree's API port (otherwise scripts/port.sh picks one; web uses API_PORT+1)
# API_PORT=8100
